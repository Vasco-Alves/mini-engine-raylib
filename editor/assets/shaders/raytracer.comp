#version 430 core

layout(rgba8, binding = 0) uniform image2D img_output;

// ============================================================================
// MEMORY STRUCTURES (must match gpu_types.hpp exactly)
// ============================================================================
struct GPUTriangle {
    vec3 v0; float pad0;
    vec3 v1; float pad1;
    vec3 v2; float pad2;
};
struct GPUNode {
    vec3 bounds_min; uint left_child;
    vec3 bounds_max; uint count;
};
struct GPUMaterial {
    vec3 base_color; float roughness;
    float metallic; float emission; float transmission; float ior;
};
struct GPUPrimitive {
    int type; int material_index; int blas_root_index; float pad0;
    mat4 inverse_model;
    mat4 normal_matrix;
};
struct GPUPointLight {
    vec3 position; float pad0;
    vec3 color;    float intensity;
};
struct GPUDirLight {
    vec3 direction; float pad0; // direction TOWARD the light
    vec3 color;     float intensity;
};
struct GPUEmitter {
    vec3 position; float radius;   // bounding-sphere center + radius
    vec3 emission; float pad0;     // linear radiance (base_color * emission_power)
};

// ============================================================================
// SSBO BINDINGS
// ============================================================================
layout(std430, binding = 1) readonly buffer NodeBuffer  { GPUNode      bvh_nodes[]; };
layout(std430, binding = 2) readonly buffer TriBuffer   { GPUTriangle  triangles[];  };
layout(std430, binding = 3) readonly buffer MatBuffer   { GPUMaterial  materials[];  };
layout(std430, binding = 4) readonly buffer PrimBuffer  { GPUPrimitive primitives[]; };
layout(std430, binding = 5) readonly buffer PLBuffer    { GPUPointLight point_lights[]; };
layout(std430, binding = 6) readonly buffer DLBuffer    { GPUDirLight  dir_lights[];   };
layout(std430, binding = 7) readonly buffer EmitBuffer  { GPUEmitter   emitters[];     };

// ============================================================================
// UNIFORMS
// ============================================================================
uniform vec3  cam_pos;
uniform vec3  cam_fwd;
uniform vec3  cam_up;
uniform vec3  cam_right;
uniform float cam_fov_scale;
uniform uint  frame_count;
uniform uint  total_frames;
uniform int   max_bounces;
uniform int   num_point_lights;
uniform int   num_dir_lights;
uniform int   num_emitters;

// --- Environment (art-directable; matches the CPU backend) ---
uniform float ambient_strength;
uniform vec3  sky_horizon;
uniform vec3  sky_zenith;
uniform float sky_intensity;

const float PI     = 3.14159265359;
const float INV_PI = 0.31830988618;

// ============================================================================
// TYPES
// ============================================================================
struct Ray { vec3 origin; vec3 direction; };
struct HitInfo { float t; vec3 normal; int mat_index; bool front_face; };

// ============================================================================
// RNG
// ============================================================================
uint pcg_hash(inout uint seed) {
    uint state = seed * 747796405u + 2891336453u;
    uint word  = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    seed = (word >> 22u) ^ word;
    return seed;
}
float random_float(inout uint seed) { return float(pcg_hash(seed)) / 4294967295.0; }
vec3 random_unit_vector(inout uint seed) {
    for (int i = 0; i < 32; i++) {
        vec3 p = vec3(random_float(seed)*2.0-1.0, random_float(seed)*2.0-1.0, random_float(seed)*2.0-1.0);
        float lsq = dot(p, p);
        if (lsq > 0.001 && lsq <= 1.0) return p * inversesqrt(lsq);
    }
    return vec3(0.0, 1.0, 0.0);
}
float halton(uint index, uint base) {
    float f = 1.0, r = 0.0;
    while (index > 0u) { f /= float(base); r += f * float(index % base); index /= base; }
    return r;
}

// ============================================================================
// MATH HELPERS
// ============================================================================
vec3 sample_sky(vec3 dir) {
    float t = 0.5 * (dir.y + 1.0);
    return mix(sky_horizon, sky_zenith, t) * sky_intensity;
}
float schlick(float cosine, float ref_idx) {
    float r0 = (1.0 - ref_idx) / (1.0 + ref_idx); r0 *= r0;
    return r0 + (1.0 - r0) * pow(1.0 - cosine, 5.0);
}

// Raylib stores matrices row-major; GLSL reads SSBOs column-major (effectively
// transposing them). Pre-multiplying (v * M) corrects for this.
vec3 rl_transform_point(mat4 m, vec3 p) { return (vec4(p, 1.0) * m).xyz; }
vec3 rl_transform_dir  (mat4 m, vec3 d) { return (vec4(d, 0.0) * m).xyz; }

vec3 safe_inv_dir(vec3 d) {
    return 1.0 / vec3(
        abs(d.x) > 1e-8 ? d.x : (d.x >= 0.0 ? 1e-8 : -1e-8),
        abs(d.y) > 1e-8 ? d.y : (d.y >= 0.0 ? 1e-8 : -1e-8),
        abs(d.z) > 1e-8 ? d.z : (d.z >= 0.0 ? 1e-8 : -1e-8));
}

// ============================================================================
// AABB SLAB TEST
// ============================================================================
float intersect_aabb(vec3 origin, vec3 inv_dir, vec3 bmin, vec3 bmax, float max_t) {
    vec3 t1 = (bmin - origin) * inv_dir;
    vec3 t2 = (bmax - origin) * inv_dir;
    float t_min = max(max(min(t1.x,t2.x), min(t1.y,t2.y)), min(t1.z,t2.z));
    float t_max = min(min(max(t1.x,t2.x), max(t1.y,t2.y)), max(t1.z,t2.z));
    if (t_max < 0.0 || t_min > t_max || t_min > max_t) return 1e38;
    return t_min;
}

// ============================================================================
// PRIMITIVE INTERSECTIONS
// ============================================================================
bool intersect_sphere(Ray ray, mat4 inv_model, mat4 normal_mat, out float world_t, out vec3 world_n) {
    vec3 lo = rl_transform_point(inv_model, ray.origin);
    vec3 ld = normalize(rl_transform_dir(inv_model, ray.direction));
    float b = 2.0 * dot(lo, ld), c = dot(lo, lo) - 1.0;
    float disc = b*b - 4.0*c;
    if (disc < 0.0) return false;
    float sq = sqrt(disc), t = (-b - sq) * 0.5;
    if (t < 0.001) t = (-b + sq) * 0.5;
    if (t < 0.001) return false;
    vec3 local_hit = lo + ld * t;
    world_t = length(rl_transform_point(inverse(inv_model), local_hit) - ray.origin);
    world_n = normalize(rl_transform_dir(normal_mat, local_hit));
    return true;
}

bool intersect_plane(Ray ray, mat4 inv_model, mat4 normal_mat, out float world_t, out vec3 world_n) {
    vec3 lo = rl_transform_point(inv_model, ray.origin);
    vec3 ld = normalize(rl_transform_dir(inv_model, ray.direction));
    if (abs(ld.y) < 1e-8) return false;
    float t = -lo.y / ld.y;
    if (t < 0.001) return false;
    world_t = length(rl_transform_point(inverse(inv_model), lo + ld * t) - ray.origin);
    world_n = normalize(rl_transform_dir(normal_mat, vec3(0.0, 1.0, 0.0)));
    return true;
}

bool intersect_cube(Ray ray, mat4 inv_model, mat4 normal_mat, out float world_t, out vec3 world_n) {
    vec3 lo = rl_transform_point(inv_model, ray.origin);
    vec3 ld = normalize(rl_transform_dir(inv_model, ray.direction));
    float t_enter = -1e38, t_exit = 1e38;
    int hit_axis = -1; float hit_sign = 1.0;
    for (int axis = 0; axis < 3; axis++) {
        float d = (axis==0)?ld.x:(axis==1)?ld.y:ld.z;
        float o = (axis==0)?lo.x:(axis==1)?lo.y:lo.z;
        if (abs(d) < 1e-8) { if (abs(o) > 1.0) return false; continue; }
        float inv_d = 1.0/d, t1=(-1.0-o)*inv_d, t2=(1.0-o)*inv_d, s=-1.0;
        if (t1>t2){float tmp=t1;t1=t2;t2=tmp;s=1.0;}
        if (t1>t_enter){t_enter=t1;hit_axis=axis;hit_sign=s;}
        t_exit=min(t_exit,t2);
        if (t_enter>t_exit) return false;
    }
    if (t_enter < 0.001 || hit_axis < 0) return false;
    world_t = length(rl_transform_point(inverse(inv_model), lo + ld*t_enter) - ray.origin);
    vec3 local_n = vec3(0.0);
    if(hit_axis==0)local_n.x=hit_sign; else if(hit_axis==1)local_n.y=hit_sign; else local_n.z=hit_sign;
    world_n = normalize(rl_transform_dir(normal_mat, local_n));
    return true;
}

bool intersect_triangle_mt(vec3 ro, vec3 rd, vec3 v0, vec3 v1, vec3 v2, out float t) {
    vec3 e1=v1-v0, e2=v2-v0, h=cross(rd,e2);
    float a=dot(e1,h); if(abs(a)<1e-8) return false;
    float f=1.0/a; vec3 s=ro-v0; float u=f*dot(s,h);
    if(u<0.0||u>1.0) return false;
    vec3 q=cross(s,e1); float v=f*dot(rd,q);
    if(v<0.0||u+v>1.0) return false;
    t=f*dot(e2,q); return t>0.001;
}

// ============================================================================
// BLAS TRAVERSAL
// ============================================================================
bool traverse_blas(vec3 ro, vec3 rd, int blas_root, out float best_t, out vec3 best_n) {
    vec3 inv_dir = safe_inv_dir(rd); best_t = 1e38; bool hit = false;
    int stack[64]; int top=0; stack[top++]=blas_root;
    while (top > 0) {
        GPUNode node = bvh_nodes[stack[--top]];
        if (intersect_aabb(ro, inv_dir, node.bounds_min, node.bounds_max, best_t) >= 1e37) continue;
        if (node.count > 0u) {
            for (uint i=node.left_child; i<node.left_child+node.count; i++) {
                float t;
                if (intersect_triangle_mt(ro, rd, triangles[i].v0, triangles[i].v1, triangles[i].v2, t) && t < best_t) {
                    best_t=t; hit=true;
                    best_n=normalize(cross(triangles[i].v1-triangles[i].v0, triangles[i].v2-triangles[i].v0));
                }
            }
        } else { stack[top++]=int(node.left_child); stack[top++]=int(node.left_child)+1; }
    }
    return hit;
}

// ============================================================================
// SCENE TRAVERSAL — full hit info
// ============================================================================
bool traverse_scene(Ray ray, out HitInfo hit) {
    vec3 inv_dir = safe_inv_dir(ray.direction);
    float best_t = 1e38; bool found = false;
    int stack[64]; int top=0; stack[top++]=0;

    while (top > 0) {
        GPUNode node = bvh_nodes[stack[--top]];
        if (intersect_aabb(ray.origin, inv_dir, node.bounds_min, node.bounds_max, best_t) >= 1e37) continue;

        if (node.count > 0u) {
            for (uint pi=node.left_child; pi<node.left_child+node.count; pi++) {
                GPUPrimitive prim = primitives[pi];
                float t; vec3 n; bool prim_hit = false;

                if (prim.type == 0) {
                    prim_hit = intersect_sphere(ray, prim.inverse_model, prim.normal_matrix, t, n);
                } else if (prim.type == 1) {
                    prim_hit = intersect_plane(ray, prim.inverse_model, prim.normal_matrix, t, n);
                    if (prim_hit && dot(n, ray.direction) > 0.0) n = -n;
                } else if (prim.type == 2) {
                    prim_hit = intersect_cube(ray, prim.inverse_model, prim.normal_matrix, t, n);
                } else if (prim.type == 3 && prim.blas_root_index >= 0) {
                    vec3 lo = rl_transform_point(prim.inverse_model, ray.origin);
                    vec3 ld = normalize(rl_transform_dir(prim.inverse_model, ray.direction));
                    float local_t; vec3 local_n;
                    if (traverse_blas(lo, ld, prim.blas_root_index, local_t, local_n)) {
                        vec3 world_hit = rl_transform_point(inverse(prim.inverse_model), lo + ld*local_t);
                        t = length(world_hit - ray.origin);
                        if (t < best_t) { n = normalize(rl_transform_dir(prim.normal_matrix, local_n)); prim_hit = true; }
                    }
                }

                if (prim_hit && t > 0.001 && t < best_t) {
                    best_t = t; found = true;
                    hit.t = t; hit.mat_index = prim.material_index;
                    hit.front_face = dot(n, ray.direction) < 0.0;
                    hit.normal = hit.front_face ? n : -n;
                }
            }
        } else { stack[top++]=int(node.left_child); stack[top++]=int(node.left_child)+1; }
    }
    return found;
}

// ============================================================================
// SHADOW TRAVERSAL — early-exit bool, no HitInfo allocation
// ============================================================================
bool shadow_test(vec3 origin, vec3 dir, float max_t) {
    vec3 inv_dir = safe_inv_dir(dir);
    int stack[64]; int top=0; stack[top++]=0;
    bool blocked = false;

    while (top > 0 && !blocked) {
        GPUNode node = bvh_nodes[stack[--top]];
        if (intersect_aabb(origin, inv_dir, node.bounds_min, node.bounds_max, max_t) >= 1e37) continue;

        if (node.count > 0u) {
            for (uint pi=node.left_child; pi<node.left_child+node.count && !blocked; pi++) {
                GPUPrimitive prim = primitives[pi];
                float t; vec3 n_dummy;

                if (prim.type == 0) {
                    Ray r; r.origin=origin; r.direction=dir;
                    if (intersect_sphere(r, prim.inverse_model, prim.normal_matrix, t, n_dummy) && t < max_t) blocked=true;
                } else if (prim.type == 1) {
                    Ray r; r.origin=origin; r.direction=dir;
                    if (intersect_plane(r, prim.inverse_model, prim.normal_matrix, t, n_dummy) && t < max_t) blocked=true;
                } else if (prim.type == 2) {
                    Ray r; r.origin=origin; r.direction=dir;
                    if (intersect_cube(r, prim.inverse_model, prim.normal_matrix, t, n_dummy) && t < max_t) blocked=true;
                } else if (prim.type == 3 && prim.blas_root_index >= 0) {
                    vec3 lo = rl_transform_point(prim.inverse_model, origin);
                    vec3 ld = normalize(rl_transform_dir(prim.inverse_model, dir));
                    float local_t; vec3 ln;
                    if (traverse_blas(lo, ld, prim.blas_root_index, local_t, ln)) {
                        vec3 wh = rl_transform_point(inverse(prim.inverse_model), lo + ld*local_t);
                        if (length(wh - origin) < max_t) blocked = true;
                    }
                }
            }
        } else { stack[top++]=int(node.left_child); stack[top++]=int(node.left_child)+1; }
    }
    return blocked;
}

// ============================================================================
// DIRECT LIGHTING  (mirrors CPU trace_ray direct pass exactly)
// ============================================================================
vec3 compute_direct(vec3 shadow_origin, vec3 normal) {
    vec3 direct = vec3(0.0);

    for (int i = 0; i < num_point_lights; i++) {
        GPUPointLight l = point_lights[i];
        vec3  lvec  = l.position - shadow_origin;
        float ldist = length(lvec);
        vec3  ldir  = lvec / ldist;
        if (!shadow_test(shadow_origin, ldir, ldist)) {
            float ndotl = max(0.0, dot(normal, ldir));
            direct += ndotl * l.color * l.intensity;
        }
    }

    for (int i = 0; i < num_dir_lights; i++) {
        GPUDirLight dl = dir_lights[i];
        if (!shadow_test(shadow_origin, dl.direction, 1e38)) {
            float ndotl = max(0.0, dot(normal, dl.direction));
            direct += ndotl * dl.color * dl.intensity;
        }
    }

    // --- Emissive area lights (Next Event Estimation) ---
    // Each emitter is a sphere light sampled deterministically at its center, so
    // it adds illumination with NO extra noise. The solid angle of its bounding
    // sphere gives a plausible size/distance falloff. Mirrors the CPU backend.
    for (int i = 0; i < num_emitters; i++) {
        GPUEmitter em = emitters[i];
        vec3  lvec = em.position - shadow_origin;
        float dist = length(lvec);
        if (dist < 1e-4) continue;
        vec3  ldir = lvec / dist;

        float ndotl = max(0.0, dot(normal, ldir));
        if (ndotl <= 0.0) continue;

        float sin2    = min((em.radius * em.radius) / (dist * dist), 0.9999);
        float cos_max = sqrt(1.0 - sin2);
        float omega   = 2.0 * PI * (1.0 - cos_max);

        // Stop the shadow ray before the emitter's near surface so it doesn't
        // shadow itself.
        float shadow_max = dist - em.radius - 0.001;
        bool  visible = true;
        if (shadow_max > 0.001) visible = !shadow_test(shadow_origin, ldir, shadow_max);

        if (visible) direct += em.emission * (ndotl * omega * INV_PI);
    }

    return direct;
}

// ============================================================================
// ENTRY POINT
// ============================================================================
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main() {
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(img_output);
    if (pixel_coords.x >= dims.x || pixel_coords.y >= dims.y) return;

    uint seed = uint(pixel_coords.y * dims.x + pixel_coords.x) + total_frames * 719393u;

    float jitter_x = halton(frame_count, 2u) - 0.5;
    float jitter_y = halton(frame_count, 3u) - 0.5;
    float ndc_x = (2.0*(float(pixel_coords.x)+0.5+jitter_x)/float(dims.x))-1.0;
    float ndc_y = 1.0-(2.0*(float(pixel_coords.y)+0.5+jitter_y)/float(dims.y));
    float aspect = float(dims.x)/float(dims.y);

    Ray ray;
    ray.origin    = cam_pos;
    ray.direction = normalize(cam_fwd + cam_right*(ndc_x*aspect*cam_fov_scale) + cam_up*(ndc_y*cam_fov_scale));

    vec3 final_color = vec3(0.0);
    vec3 throughput  = vec3(1.0);

    // Whether the current ray may add an emitter's surface radiance. True for the
    // camera ray and specular/glass bounces; set false after a diffuse bounce
    // because Next Event Estimation already counted that emitter directly.
    bool allow_emissive = true;

    for (int bounce = 0; bounce <= max_bounces; bounce++) {
        HitInfo hit;
        if (!traverse_scene(ray, hit)) {
            final_color += throughput * sample_sky(ray.direction);
            break;
        }

        GPUMaterial mat = materials[hit.mat_index];

        // Emissive — early out (gated to avoid double-counting NEE)
        if (mat.emission > 0.0) {
            if (allow_emissive) final_color += throughput * mat.base_color * mat.emission;
            break;
        }

        vec3 hit_point     = ray.origin + ray.direction * hit.t;
        vec3 shadow_origin = hit_point + hit.normal * 0.001;

        // Russian Roulette
        float survival_p = 1.0;
        if (bounce >= 2) {
            survival_p = clamp(max(mat.base_color.r, max(mat.base_color.g, mat.base_color.b)), 0.1, 0.95);
            if (random_float(seed) > survival_p) break;
        }
        throughput /= survival_p;

        if (mat.transmission > 0.0) {
            // Glass — no direct lighting contribution, scatter only
            float eta   = hit.front_face ? (1.0/mat.ior) : mat.ior;
            vec3  udir  = normalize(ray.direction);
            float cos_t = min(dot(-udir, hit.normal), 1.0);
            float sin_t = sqrt(1.0 - cos_t*cos_t);
            vec3 new_dir;
            if (eta*sin_t > 1.0 || schlick(cos_t, eta) > random_float(seed))
                new_dir = reflect(udir, hit.normal);
            else
                new_dir = refract(udir, hit.normal, eta);
            if (mat.roughness > 0.0)
                new_dir = normalize(new_dir + random_unit_vector(seed)*mat.roughness);
            float bias = dot(new_dir, hit.normal) < 0.0 ? -0.001 : 0.001;
            ray.origin    = hit_point + hit.normal*bias;
            ray.direction = normalize(new_dir);
            throughput   *= mat.base_color;
            allow_emissive = true; // glass is specular: it may see emitters
        } else {
            // Opaque — direct lighting + ambient + scatter (mirrors CPU trace_ray)
            vec3 direct = compute_direct(shadow_origin, hit.normal);
            direct *= mat.roughness * (1.0 - mat.metallic);

            vec3 ambient = sample_sky(hit.normal) * ambient_strength * mat.roughness;

            final_color += throughput * mat.base_color * (direct + ambient);

            // Scatter
            vec3 reflect_dir = reflect(normalize(ray.direction), hit.normal);
            vec3 diffuse_dir = normalize(hit.normal + random_unit_vector(seed));
            vec3 new_dir     = normalize(mix(reflect_dir, diffuse_dir, mat.roughness));
            if (dot(new_dir, hit.normal) < 0.0) new_dir = diffuse_dir;

            float white_blend = (1.0 - mat.metallic) * (1.0 - mat.roughness);
            vec3  bounce_tint = mix(mat.base_color, vec3(1.0), white_blend);
            float bw          = (1.0 - mat.roughness) + mat.roughness*0.5;

            ray.origin    = shadow_origin;
            ray.direction = new_dir;
            throughput   *= bounce_tint * bw;
            // Near-mirror surfaces may still show emitters; rougher (diffuse)
            // surfaces already received emitter light through NEE.
            allow_emissive = (mat.roughness < 0.1);
        }
    }

    // ACES Filmic + gamma (matches CPU)
    final_color *= 0.6;
    final_color  = (final_color*(2.51*final_color+0.03)) / (final_color*(2.43*final_color+0.59)+0.14);
    final_color  = sqrt(clamp(final_color, 0.0, 1.0));

    // GPU accumulation — running average across frames
    vec4 new_sample = vec4(final_color, 1.0);
    if (frame_count <= 1u) {
        imageStore(img_output, pixel_coords, new_sample);
    } else {
        vec4 prev = imageLoad(img_output, pixel_coords);
        imageStore(img_output, pixel_coords, mix(prev, new_sample, 1.0/float(frame_count)));
    }
}